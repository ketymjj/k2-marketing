{
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "K2Marketing",
    "Audience": "K2Marketing.Web",
    "Secret": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Cors": { "Origins": [ "http://localhost:4200" ] },
  "Storage": { "RootPath": "storage" },
  "Database": { "MigrateOnStartup": true, "Seed": true },
  "Jobs": { "NotificationsEnabled": true, "NotificationIntervalMinutes": 30 },
  "RateLimiting": { "AuthPermitPerMinute": 10 },
  "Swagger": { "Enabled": true },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
