# Copie para .env e defina valores próprios. NUNCA versione o arquivo .env.
POSTGRES_DB=k2marketing
POSTGRES_USER=k2marketing
# Senha usada apenas em desenvolvimento local (igual ao appsettings.Development.json). Troque em produção.
POSTGRES_PASSWORD=k2marketing_dev
POSTGRES_PORT=5435

# Segredo de assinatura dos tokens JWT (mínimo 32 caracteres; gere um valor aleatório).
JWT_SECRET=troque-por-um-segredo-aleatorio-com-32-ou-mais-caracteres

API_PORT=5090
WEB_PORT=4290
ASPNETCORE_ENVIRONMENT=Production
SEED_DEMO_DATA=true
SWAGGER_ENABLED=true

